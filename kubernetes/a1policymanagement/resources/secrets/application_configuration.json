{
  "config": {
    "controller": [
      {
        "name": "controller1",
        "baseUrl": "{{ .Values.sdncLink }}",
        "userName": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "controller-secret" "key" "login") | toJson }},
        "password": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "controller-secret" "key" "password") | toJson }}
      }
    ],
    "ric": {{ include "a1p.generateRics" . | indent 6 | trim}}
  }
}
