{
  "cmpv2Servers": [
    {
      "caName": "CLIENT",
      "url": "http://ejbca:8080/ejbca/publicweb/cmp/cmp",
      "issuerDN": "O=EJBCA Container Quickstart,CN=ManagementCA,UID=12345",
      "caMode": "CLIENT",
      "authentication": {
        "iak": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "ejbca-server-client-iak" "key" "password") | toJson }},
        "rv": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "cmp-config-client-rv" "key" "password") | toJson }}
      }
    },
    {
      "caName": "RA",
      "url": "http://ejbca:8080/ejbca/publicweb/cmp/cmpRA",
      "issuerDN": "O=EJBCA Container Quickstart,CN=ManagementCA,UID=12345",
      "caMode": "RA",
      "authentication": {
        "iak": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "ejbca-server-ra-iak" "key" "password") | toJson }},
        "rv": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "cmp-config-ra-rv" "key" "password") | toJson }}
      }
    }
  ]
}
