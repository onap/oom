{
    "name": "XacmlPdpParameters",
    "pdpGroup": "defaultGroup",
    "pdpType": "xacml",
    "restServerParameters": {
        "host": "0.0.0.0",
        "port": 6969,
        "userName": "${RESTSERVER_USER}",
        "password": "${RESTSERVER_PASSWORD}",
        "https": "false",
        "aaf": false,
        "prometheus": true
    },
    "policyApiParameters": {
        "hostname": "policy-api",
        "port": 6969,
        "userName": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "api-creds" "key" "login") | toJson }},
        "password": {{ include "common.secret.renderedValueFast" (dict "global" . "uid" "api-creds" "key" "password") | toJson }},
        "useHttps": "false",
        "aaf": false
    },
    "applicationParameters": {
        "applicationPath": "/opt/app/policy/pdpx/apps"
    },
    "topicParameterGroup": {
        "topicSources": [{
          "topic": "{{ .Values.config.app.listener.policyPdpPapTopic }}",
          "useHttps": false,
          "fetchTimeout": 15000,
          "servers": [ "{{ include "common.release" . }}-{{ .Values.global.kafkaBootstrap }}" ],
          "topicCommInfrastructure": "kafka",
          "additionalProps": {
            "group.id": "${env:GROUP_ID}",
            "security.protocol": "SASL_PLAINTEXT",
            "sasl.mechanism": "{{ .Values.kafkaUser.authenticationType | upper }}",
            "sasl.jaas.config": "${directory:/etc/kafka-user:sasl.jaas.config}",
            "config.providers": "directory,env",
            "config.providers.directory.class": "org.apache.kafka.common.config.provider.DirectoryConfigProvider",
            "config.providers.env.class": "org.apache.kafka.common.config.provider.EnvVarConfigProvider"
          }
        }],
        "topicSinks" : [{
          "topic": "{{ .Values.config.app.listener.policyPdpPapTopic }}",
          "useHttps": false,
          "servers": [ "{{ include "common.release" . }}-{{ .Values.global.kafkaBootstrap }}" ],
          "topicCommInfrastructure": "kafka",
          "additionalProps": {
            "group.id": "${env:GROUP_ID}",
            "security.protocol": "SASL_PLAINTEXT",
            "sasl.mechanism": "{{ .Values.kafkaUser.authenticationType | upper }}",
            "sasl.jaas.config": "${directory:/etc/kafka-user:sasl.jaas.config}",
            "config.providers": "directory,env",
            "config.providers.directory.class": "org.apache.kafka.common.config.provider.DirectoryConfigProvider",
            "config.providers.env.class": "org.apache.kafka.common.config.provider.EnvVarConfigProvider"
          }
      }]
    }
}
